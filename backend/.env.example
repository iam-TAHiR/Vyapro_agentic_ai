# Copy this file to .env and replace the placeholders with local values.
# Do not commit .env or put real credentials in this example file.
VYAPRO_ENV=development
VYAPRO_DEBUG=false
VYAPRO_HOST=127.0.0.1
VYAPRO_PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vyapro_dev
MYSQL_USER=your_local_mysql_user
MYSQL_PASSWORD=replace_with_your_local_password
MYSQL_CONNECT_TIMEOUT=3

# Optional OpenAI-compatible Chat Completions endpoint for order interpretation.
# Leave unset to keep natural-language proposal creation unavailable.
VYAPRO_LLM_BASE_URL=
VYAPRO_LLM_MODEL=
VYAPRO_LLM_API_KEY=
VYAPRO_LLM_TIMEOUT=20
VYAPRO_TRANSCRIPTION_MODEL=

# Bounded Vyapro tool-agent policy. Autonomous submission is off by default.
VYAPRO_AGENT_MAX_ITERATIONS=5
VYAPRO_AGENT_MAX_SECONDS=45
VYAPRO_AGENT_AUTONOMOUS_ROUTINE_ORDERS=false
# Amount is in minor currency units; only used when autonomous orders are enabled.
VYAPRO_AGENT_AUTONOMOUS_MAX_MINOR=0
